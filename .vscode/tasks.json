{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve TorqueLine",
            "type": "shell",
            "command": "./serve.sh",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "TorqueLine running at",
                    "endsPattern": "Serving HTTP"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": "build"
        }
    ]
}
